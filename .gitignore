# Ignore Tableau packaged workbooks and extracts (large binary files)
*.hyper
*.tde
*.tdsx
*.tdm

# Ignore raw datasets (large CSVs)
Data/*.csv
data/*.csv

# Ignore OS & Editor junk
.DS_Store
Thumbs.db

# Ignore temporary / backup files
*.bak
*.tmp
*.log

# Ignore virtual environments (if used later)
venv/
.env
# Exceptions: these specific files are small (<250 KB) and are the only
# copies that exist, so they are tracked despite the rules above.
!federated.hyper
!federated 1.hyper
!Data/Lottery_Powerball_Winning_Numbers__Beginning_2010.csv
