    <worksheet name='05 - Even vs. Odd Main Numbers'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Even vs. Odd Main Numbers</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='lottery (pivoted)' name='federated.1kpaa5w1vmztcx11lvwun0nzoxtl (copy)' />
            <datasource caption='lottery' name='federated.1kpaa5w1vmztcx11lvwun0nzoxtl' />
          </datasources>
          <datasource-dependencies datasource='federated.1kpaa5w1vmztcx11lvwun0nzoxtl'>
            <column caption='Draw Date' datatype='date' name='[draw_date]' role='dimension' type='ordinal' />
            <column-instance column='[draw_date]' derivation='None' name='[none:draw_date:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1kpaa5w1vmztcx11lvwun0nzoxtl (copy)'>
            <column caption='Main Number Parity' datatype='string' name='[Calculation_327425770877480963]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [main_number] % 2 = 0 THEN &quot;Even&quot;&#10;ELSE &quot;Odd&quot;&#10;END' />
